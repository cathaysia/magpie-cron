{
  "name": "magpie-cron",
  "version": "0.1.0",
  "description": "Magpie plugin to periodically disable or enable models under specific providers via cron schedules",
  "type": "module",
  "main": "./middleware.js",
  "files": [
    "middleware.js",
    "ui/",
    "README.md",
    "LICENSE"
  ],
  "magpie": {
    "middleware": "./middleware.js",
    "panels": [
      {
        "slot": "settings",
        "file": "ui/index.html",
        "title": "Model Cron Scheduler",
        "titles": {
          "zh": "模型定时计划"
        }
      }
    ],
    "permissions": ["providers:list"]
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "middleware",
    "cron",
    "scheduler",
    "model-manager"
  ],
  "author": "cathaysia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cathaysia/magpie-cron.git"
  }
}
